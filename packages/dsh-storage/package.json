{
  "name": "dsh-storage",
  "version": "0.1.0",
  "description": "Session storage mirror for DeepSeek Harness: projects the session event stream into MySQL/PostgreSQL/SQLite/SQL Server (ai_messages / ai_chat_histories) without replacing dsh's local persistence.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "prisma",
    "cordis.patch.yml",
    "preview.png"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/prisma-generate.mjs && tsc -p tsconfig.build.json",
    "generate": "node scripts/prisma-generate.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/adapter-mssql": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1"
  },
  "peerDependenciesMeta": {
    "@prisma/adapter-libsql": {
      "optional": true
    },
    "@prisma/adapter-mariadb": {
      "optional": true
    },
    "@prisma/adapter-mssql": {
      "optional": true
    },
    "@prisma/adapter-pg": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/adapter-mssql": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/node": "^22.0.0",
    "prisma": "^7.9.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  }
}
