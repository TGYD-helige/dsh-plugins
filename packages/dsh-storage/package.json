{
  "name": "dsh-storage",
  "version": "0.1.0",
  "description": "Session storage mirror for DeepSeek Harness: projects the session event stream into MySQL/PostgreSQL, Redis, and/or GCS without replacing dsh's local persistence.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "prisma",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^4.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": ">=0.0.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "@google-cloud/storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
