// Prisma schema for the dsh-storage database backend — MySQL variant (Prisma 7).
//
// Table layout matches the source project's ai_messages / ai_chat_histories
// (packages/core/prisma/schema.prisma) so existing data stays compatible:
//   - `type` values come from the dsh session event map
//     ('user' | 'model' | 'tool' | ...) instead of gemini-cli message roles.
//   - `agent_id` distinguishes the main agent from subagent writers.
//   - no user_id: tenancy is carried by session_id, not a column.
//
// The client is pre-generated at package build time (`pnpm generate`, output
// src/generated/mysql, compiled into lib/generated) — consumers do NOT run
// `prisma generate`. To create/upgrade tables, run `prisma db push` /
// migrations against this file; the connection URL lives in prisma.config.ts
// (Prisma 7 dropped datasource.url from the schema).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/mysql"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

/// One row per projected session event (user message, assistant message,
/// tool call/result, compression snapshot, ...).
model AiMessage {
  id            String    @id @default(cuid()) @db.Char(36)
  sessionId     String    @map("session_id") @db.VarChar(100)
  historyId     String?   @map("history_id") @db.Char(36)
  type          String    @db.VarChar(50)
  content       String    @db.LongText
  thoughts      Json?
  model         String?   @db.VarChar(100)
  tokens        Json?
  toolCalls     Json?     @map("tool_calls")
  agentId       String?   @map("agent_id") @db.VarChar(100)
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamp(0)

  // Relations
  history       AiChatHistory? @relation(fields: [historyId], references: [id], onDelete: NoAction)

  @@index([sessionId], map: "idx_session")
  @@index([historyId], map: "idx_history")
  @@index([createdAt], map: "idx_created")
  @@index([deletedAt], map: "idx_deleted")
  @@index([agentId], map: "idx_agent")
  @@index([sessionId, agentId, type, createdAt], map: "idx_session_agent_type_created")
  @@map("ai_messages")
}

/// Per-session rollup, maintained incrementally by the projector.
model AiChatHistory {
  id             String    @id @default(cuid()) @db.Char(36)
  sessionId      String    @map("session_id") @db.VarChar(100)
  title          String?   @db.VarChar(255)
  summary        String?   @db.Text
  messageCount   Int       @default(0) @map("message_count")
  totalTokens    BigInt    @default(0) @map("total_tokens")
  firstMessageAt DateTime? @map("first_message_at") @db.DateTime(6)
  lastMessageAt  DateTime? @map("last_message_at") @db.DateTime(6)
  metadata       Json?
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(6)

  // Relations
  messages       AiMessage[]

  @@index([sessionId], map: "idx_chat_history_session")
  @@index([deletedAt], map: "idx_chat_history_deleted")
  @@map("ai_chat_histories")
}
