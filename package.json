{
  "name": "dsh-plugins",
  "private": true,
  "type": "module",
  "description": "Generic DeepSeek Harness (dsh) plugins: A2A protocol server, session storage mirror, Langfuse observability.",
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "node --test .github/scripts/integration-workflow.test.mjs && pnpm -r run test",
    "test:sdk": "pnpm --filter @amaster.ai/dsh-langfuse... build && node .github/scripts/integration/lib/langfuse-sdk-check.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:otlp": "pnpm --filter @amaster.ai/dsh-telemetry... build && node .github/scripts/integration/lib/telemetry-otlp-check.mjs",
    "test:performance:network": "vitest run --config .github/scripts/integration/vitest.performance.config.mts",
    "test:performance:database": "pnpm --filter @amaster.ai/dsh-storage build && node .github/scripts/integration/lib/performance-database.mjs",
    "test:performance:combined": "pnpm --filter @amaster.ai/dsh-a2a --filter @amaster.ai/dsh-storage --filter @amaster.ai/dsh-policy --filter @amaster.ai/dsh-telemetry build && node .github/scripts/integration/lib/performance-combined.mjs",
    "test:performance": "pnpm --filter @amaster.ai/dsh-telemetry build && vitest run packages/dsh-a2a/src/stream-connection.test.ts packages/dsh-storage/src/index.test.ts packages/dsh-telemetry/src/reporter.test.ts packages/dsh-a2a/src/task-store.test.ts packages/dsh-a2a/src/inbox-changes.test.ts packages/dsh-storage/src/backends/database.test.ts packages/dsh-langfuse/src/index.test.ts packages/dsh-policy/src/rule.test.ts packages/dsh-policy/src/shell.test.ts --reporter=default --reporter=json --outputFile=performance-results.json && node .github/scripts/integration/lib/performance-overhead.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@biomejs/biome": "^2.4.15",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.2",
    "vitest": "^4.1.11",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.2-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.2",
    "@deepseek-ai/dsh-goal": "0.2.2-rc.2",
    "@deepseek-ai/dsh-goal-round-driver": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.2",
    "protobufjs": "7.6.6"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  }
}
